rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidProfile(data) {
      return data.keys().hasAny(['name', 'email', 'isOnboarded', 'role']) &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.isOnboarded is bool &&
             data.role is string;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'receiverId', 'timestamp', 'status']) &&
             data.senderId is string && data.senderId.size() <= 128 &&
             data.receiverId is string && data.receiverId.size() <= 128 &&
             data.timestamp is number &&
             data.status in ['sent', 'delivered', 'read'] &&
             (data.get('text', '') is string) &&
             (data.keys().hasAny(['file']) ? data.file is map : true);
    }

    match /profiles/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
                    isValidProfile(incoming()) &&
                    incoming().email == request.auth.token.email;
      
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
                    isValidProfile(incoming()) &&
                    incoming().role == existing().role &&
                    incoming().email == existing().email;
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if isSignedIn() && isValidId(chatId) &&
                  (existing().senderId == request.auth.token.email || existing().receiverId == request.auth.token.email);
      
      allow list: if isSignedIn() && isValidId(chatId); // We should restrict but since we don't know chatId format, wait...
      
      allow create: if isSignedIn() && isValidId(chatId) && isValidId(messageId) &&
                    isValidMessage(incoming()) &&
                    incoming().senderId == request.auth.token.email;
      
      allow update: if isSignedIn() && isValidId(chatId) && isValidId(messageId) &&
                    isValidMessage(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                    existing().receiverId == request.auth.token.email;
    }
  }
}
