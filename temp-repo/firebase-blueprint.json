{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "User profile containing basic info, preferences, and state",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "isOnboarded": { "type": "boolean" },
        "role": { "type": "string", "enum": ["user", "nutricionista"] },
        "crn": { "type": "string" },
        "preferences": { "type": "object" },
        "savedPlans": { "type": "array" },
        "profilePicture": { "type": "string" },
        "isAppleWatchConnected": { "type": "boolean" },
        "isGoogleFitConnected": { "type": "boolean" },
        "isGarminConnected": { "type": "boolean" },
        "mealReminders": { "type": "array" },
        "waterReminders": { "type": "object" },
        "recordedMeals": { "type": "array" },
        "waterIntake": { "type": "number" },
        "activityMinutes": { "type": "number" },
        "sleepHours": { "type": "number" },
        "goalTargetDates": { "type": "object" }
      },
      "required": ["name", "email", "isOnboarded", "role"]
    },
    "Message": {
      "title": "Message",
      "description": "A chat message",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "timestamp": { "type": "number" },
        "status": { "type": "string", "enum": ["sent", "delivered", "read"] },
        "file": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "type": { "type": "string" },
            "size": { "type": "string" },
            "url": { "type": "string" }
          }
        }
      },
      "required": ["senderId", "receiverId", "timestamp", "status"]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": { "$ref": "#/entities/Profile" },
      "description": "User profiles"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Chat messages between user and nutritionist"
    }
  }
}
