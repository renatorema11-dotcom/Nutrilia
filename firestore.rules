rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidProfile(data) {
      return data.keys().hasAny(['name', 'email', 'isOnboarded', 'role']) &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.isOnboarded is bool &&
             data.role is string;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'receiverId', 'timestamp', 'status']) &&
             data.senderId is string && data.senderId.size() <= 128 &&
             data.receiverId is string && data.receiverId.size() <= 128 &&
             data.timestamp is number &&
             data.status in ['sent', 'delivered', 'read'] &&
             (data.get('text', '') is string) &&
             (data.keys().hasAny(['file']) ? data.file is map : true);
    }

  match /profiles/{userId} {
      allow read: if isSignedIn();
      
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if isSignedIn();
    }
  }
}
